---
import '../../src/styles/global.css';
import { cvDataIT , navCvTextIT } from '../data/translation-it';
import NavbarCv from '../components/NavbarCv';
import RequestCvForm from '../components/RequestCvForm';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Curriculum Vitae of Veronica Galeazzo — Web Designer & Front-End Developer."
    />
    <title>Veronica Galeazzo | CV</title>
  </head>

  <body class="bg-brand-bg text-brand-text antialiased">
    <NavbarCv
      client:load 
      linkHome={navCvTextIT.linkHome}
      navProjects={navCvTextIT.navProjects}
      navCv={navCvTextIT.navCv}
      navContact={navCvTextIT.navContact}
    />

    <main class="max-w-6xl mt-16 mx-auto px-6 py-16 md:py-24">

      <section class="mb-20">
        <p class="text-sm font-mono uppercase tracking-widest text-brand-cyan mb-4">
          {cvDataIT.header.label}
        </p>

        <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight mb-5">
          {cvDataIT.header.name}
        </h1>

        <p class="text-xl md:text-2xl text-brand-muted font-display">
          {cvDataIT.header.role}
        </p>

        <p class="max-w-3xl mt-8 text-base md:text-lg leading-relaxed text-brand-muted">
          {cvDataIT.header.intro}
        </p>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <div class="lg:col-span-2 space-y-20">

          <section>
            <h2 class="text-2xl md:text-3xl font-bold font-display mb-8">
              {cvDataIT.profile.title}
            </h2>

            <p class="text-brand-muted leading-relaxed text-base md:text-lg">
              {cvDataIT.profile.text}
            </p>
          </section>

          <section>
            <h2 class="text-2xl md:text-3xl font-bold font-display mb-10">
              {cvDataIT.experienceTitle}
            </h2>

            <div class="space-y-12">
              {cvDataIT.experience.map((job, index) => (
                <article
                  class={`border-l pl-6 ${
                    index === 0
                      ? 'border-brand-cyan/40'
                      : 'border-white/10'
                  }`}
                >
                  <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-3">
                    <h3 class="text-xl font-semibold font-display">
                      {job.role}
                    </h3>

                    <span class="text-sm font-mono text-brand-muted">
                      {job.period}
                    </span>
                  </div>

                  <ul class="space-y-2 text-brand-muted leading-relaxed">
                    {job.responsibilities.map((item) => (
                      <li>• {item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-2xl md:text-3xl font-bold font-display mb-10">
              {cvDataIT.educationTitle}
            </h2>

            <div class="space-y-10">
              {cvDataIT.education.map((item) => (
                <article>
                  <h3 class="text-lg font-semibold font-display">
                    {item.title}
                  </h3>

                  <p class="text-brand-muted mt-2 leading-relaxed">
                    {item.description}
                  </p>

                  {item.qualification && (
                    <p class="text-sm text-brand-muted mt-2">
                      {item.qualification}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>

        </div>

        <aside class="space-y-12">

          <section>
            <h2 class="text-xl font-bold font-display mb-6">
              {cvDataIT.skillsTitle}
            </h2>

            <div class="space-y-6">
              {cvDataIT.skills.map((group) => (
                <div>
                  <h3 class="text-sm font-mono uppercase tracking-wider text-brand-cyan mb-3">
                    {group.category}
                  </h3>

                  <p class="text-brand-muted leading-relaxed">
                    {group.items.join(' · ')}
                  </p>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-bold font-display mb-6">
              {cvDataIT.languagesTitle}
            </h2>

            <div class="space-y-4">
              {cvDataIT.languages.map((language) => (
                <div class="flex justify-between gap-4">
                  <span>{language.name}</span>

                  <span class="text-brand-muted text-right">
                    {language.level}
                  </span>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-bold font-display mb-6">
              {cvDataIT.additionalTitle}
            </h2>

            <p class="text-brand-muted leading-relaxed">
              {cvDataIT.additional}
            </p>
          </section>

        </aside>
      </div>

      <section
        id="request-cv"
        class="mt-24 p-8 md:p-12 rounded-2xl border border-brand-cyan/20 bg-white/5"
      >
        <p class="text-sm font-mono uppercase tracking-widest text-brand-cyan mb-4">
          {cvDataIT.requestCV.label}
        </p>

        <h2 class="text-2xl md:text-3xl font-bold font-display mb-4">
          {cvDataIT.requestCV.title}
        </h2>

        <p class="text-brand-muted leading-relaxed max-w-2xl">
          {cvDataIT.requestCV.description}
        </p>

        <RequestCvForm
          client:load
          formTitle="Richiedi il mio CV completo"
          nameLabel="Nome"
          namePlaceholder="Il tuo nome"
          emailLabel="Email"
          emailPlaceholder="email@example.com"
          messageLabel="Messaggio (opzionale)"
          messagePlaceholder="Lascia un messaggio..."
          submitLabel="Invia richiesta"
          successMessage="La tua richiesta è stata inviata. Ti ricontatterò al più presto."
          errorMessage="Qualcosa è andato storto. Riprova più tardi."
        />
      </section>

    </main>
  </body>
</html>