---
import '../../src/styles/global.css';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import ProjectsSection from '../components/ProjectsSection';
import MatrixSection from '../components/Matrix';
import Footer from '../components/Footer';
import Skills from '../components/Skills';
import MinorProjects from '../components/MinorProjects';
import NavbarCv from '../components/NavbarCv';
import RequestCvForm from '../components/RequestCvForm';

import { projectsData, matrixPointsEN, heroTextEN, footerTextEN, navTextEN, skillsEN, minorProjectsEN, navCvTextEN, cvDataEN } from '../data/project';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Veronica Galeazzo | Design Engineer</title>
  </head>
  <body class="bg-brand-bg text-brand-text antialiased ">
    
    <NavbarCv
      client:load 
      linkHome={navCvTextEN.linkHome}
      navProjects={navCvTextEN.navProjects}      
      navContact={navCvTextEN.navContact}
      navCv={navCvTextEN.navCv}
    />
    
    <main class="w-full flex flex-col items-center pt-15 md:pt-5 pb-16 space-y-24 ">
      
      <Hero 
        client:load
        welcome={heroTextEN.welcome}
        titleBefore={heroTextEN.titleBefore}
        role={heroTextEN.role}
        manifesto={heroTextEN.manifesto}
        buttonWork={heroTextEN.buttonWork}
        buttonContact={heroTextEN.buttonContact}
        isIt={false}
      />
      
	  <Skills client:load skills={skillsEN} /> 

      <div class="max-w-6xl w-full px-6">
        <ProjectsSection 
          client:load 
          projects={projectsData} 
          title="Selected Projects" 
          subtitle="Case Studies"
        />
      </div>

	  	<div class="max-w-6xl w-full px-6">
			<MinorProjects 
				client:load 
				sectionTitle="Other Projects" 
				projects={minorProjectsEN} 
			/>
			</div>

      
      <div id="philosophy" class="max-w-6xl w-full px-6">
        <MatrixSection 
          client:load 
          sectionTitle="Why I Build Differently" 
          sectionSubtitle="My Approach" 
          points={matrixPointsEN} 
        />
      </div>


      
        
      
      <div class="max-w-6xl w-full px-6">
        <Footer
        client:load
        title={footerTextEN.title}
        description={footerTextEN.description}
        buttonText={footerTextEN.buttonText}
        isIt={false}
      />
        
      </div>
    </main>
  </body>
</html>
