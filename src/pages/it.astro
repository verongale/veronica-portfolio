---
import '../../src/styles/global.css';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import ProjectsSection from '../components/ProjectsSection';
import MatrixSection from '../components/Matrix';
import Footer from '../components/Footer';
import Skills from '../components/Skills';
import MinorProjects from '../components/MinorProjects';

import { projectsDataIT, matrixPointsIT, heroTextIT, footerTextIT, navTextIT, skillsIT, minorProjectsIT } from '../data/translation-it';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Veronica Galeazzo | Design Engineer</title>
  </head>
  <body class="bg-brand-bg text-brand-text antialiased">
    
    <Navbar 
      client:load 
      linkHome={navTextIT.linkHome}
      navProjects={navTextIT.navProjects}
      navPhilosophy={navTextIT.navPhilosophy}
      navContact={navTextIT.navContact}
    />
    
    <main class="w-full flex flex-col items-center pt-5 pb-16 space-y-24">
      
      <Hero 
        client:load
        welcome={heroTextIT.welcome}
        titleBefore={heroTextIT.titleBefore}
        role={heroTextIT.role}
        manifesto={heroTextIT.manifesto}
        buttonWork={heroTextIT.buttonWork}
        buttonContact={heroTextIT.buttonContact}
      />
      
	  <Skills client:load skills={skillsIT} /> 

      <div class="max-w-6xl w-full px-6">
        <ProjectsSection 
          client:load 
          projects={projectsDataIT} 
          title="Progetti Selezionati" 
          subtitle="Lavori in Evidenza"
        />

      </div>

      	<div class="max-w-6xl w-full px-6">
			<MinorProjects 
				client:load 
				sectionTitle="Altri Progetti" 
				projects={minorProjectsIT} 
			/>
			</div>
      
      <div id="philosophy" class="max-w-6xl w-full px-6">
        <MatrixSection 
          client:load 
          sectionTitle="Perché Progetto Diversamente" 
          sectionSubtitle="Filosofia" 
          points={matrixPointsIT} 
        />
      </div>
      
      <div class="max-w-6xl w-full px-6">
        <Footer 
          client:load 
          title={footerTextIT.title}
          description={footerTextIT.description}
          buttonText={footerTextIT.buttonText}
        />
      </div>
    </main>
  </body>
</html>
